# ============================================================================
# CUANLY DATABASE ENVIRONMENT VARIABLES
# ============================================================================

# Local Docker PostgreSQL Configuration
POSTGRES_DB=cuanly_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Connection string for Prisma and NestJS Backend
# 1. Local / Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cuanly_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/cuanly_db?schema=public

# 2. Vercel Postgres / Neon Cloud Postgres Example:
# DATABASE_URL=postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# 3. Supabase Cloud Postgres Example:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ==============================================================================
# NEON POSTGRESQL (Serverless Cloud - Recommended for Vercel Deployment)
# ==============================================================================
# 1. Sign up / login at https://neon.tech
# 2. Create a project named 'cuanly'
# 3. Copy the pooled connection string into DATABASE_URL:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-royal-wave-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# 4. Copy the unpooled direct connection string into DIRECT_URL (for migrations):
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-royal-wave-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
